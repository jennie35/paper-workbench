* text=auto
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
frontend/vendor/* -whitespace
*.jpg binary
*.woff2 binary

# Preserve PDF offsets and packaged binary resources on Windows checkouts.
*.pdf binary
*.bcmap binary
*.pfb binary
*.ttf binary

# Keep upstream license formatting and shipped module line endings intact.
frontend/vendor/pdfjs/** -whitespace
frontend/vendor/pdfjs/legacy/build/*.mjs text eol=lf

# Keep synthetic demo source fingerprints stable on Windows and Linux.
frontend/demos/skill-offline/**/source/synthetic-text.txt text eol=lf
