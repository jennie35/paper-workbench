# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_24_CHARACTER_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
# Origin only: do NOT include /repository/. GitHub Pages path is not part of an origin.
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io
# External private skill mount. It is never bundled with this project.
NORMAN_SKILL_HOST_PATH=/absolute/path/to/norman-paper-reading
# The supplied native engine supports Windows/macOS. Linux containers require a bridge.
NORMAN_BRIDGE_URL=https://YOUR_PRIVATE_NATIVE_BRIDGE
NORMAN_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_48_CHARACTER_TOKEN
