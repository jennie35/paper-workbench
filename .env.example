# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_24_CHARACTER_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
# Origin only: do NOT include /repository/. GitHub Pages path is not part of an origin.
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io
# Optional trusted HTTP(S) proxy for api.openai.com only; other endpoints stay IP-pinned.
OPENAI_HTTP_PROXY=
# External private skill mount. It is never bundled with this project.
NORMAN_SKILL_HOST_PATH=
NORMAN_ENABLE=auto
# The supplied native engine supports Windows/macOS. Linux containers require a bridge.
NORMAN_BRIDGE_URL=
NORMAN_BRIDGE_TOKEN=
# Optional multilingual topic graph. Weights remain in a private mounted cache.
INSTALL_EMBEDDINGS=false
EMBEDDING_ALLOW_DOWNLOAD=0
# Metered OpenAlex content attempts/day. 0 disables content downloads; public PDFs still work.
OPENALEX_CONTENT_DAILY_LIMIT=0
